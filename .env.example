# Database
DATABASE_URL=postgresql+psycopg://chartlens@localhost:5433/chartlens
TEST_DATABASE_URL=postgresql+psycopg://chartlens@localhost:5433/chartlens_test

# LLM provider: mock | ollama | ollama_cloud | groq
# mock is fully offline/deterministic; ollama_cloud + gemma4:31b is the tested cloud setup
LLM_PROVIDER=mock

# Ollama (local)
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b

# Ollama Cloud
OLLAMA_CLOUD_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional LangSmith tracing (traces leave the machine; synthetic data only)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=chartlens

# UI dev flags
VITE_SHOW_TRACE=true
